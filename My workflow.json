      "name": "HTTP Request",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. جلب محتوى الصفحة من HTTP Request\nconst rawData = $input.item.json.data;\nconst html = typeof rawData === 'string' ? rawData : JSON.stringify($input.item.json);\n\n// 2. استخراج الإيميل (مع تجاهل أسامي الصور كيما logo@2x.png)\nconst emailMatch = html.match(/[a-zA-Z0-9._-]+@[a-zA-Z0-9.-]+\\.(?!png|jpg|jpeg|gif|svg|webp)[a-zA-Z]{2,6}/i);\nconst foundEmail = emailMatch ? emailMatch[0] : \"Not found\";\n\n// 3. تنظيف كود الـ HTML وأخذ أول 3000 حرف صافي لـ Gemini\nconst cleanText = html\n  .replace(/<script[^>]*>([\\S\\s]*?)<\\/script>/gmi, '')\n  .replace(/<style[^>]*>([\\S\\s]*?)<\\/style>/gmi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\n// 4. الاحتفاظ باسم الشركة ورقم السطر من Google Sheets\nlet sheetData = {};\ntry {\n  sheetData = $('Get row(s) in sheet').item.json;\n} catch (e) {\n  try {\n    sheetData = $('Google Sheets').item.json;\n  } catch (e2) {}\n}\n\nreturn {\n  json: {\n    row_number: sheetData.row_number || \"\",\n    company: sheetData['Company Name'] || \"\",\n    extracted_email: foundEmail,\n    website_text: cleanText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "f3f276ad-c4d4-48ff-9fea-de50799b81d1",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert B2B sales copywriter. Analyze the following company website content:\nCompany Name: {{ $json.company }}\nWebsite Text: {{ $json.website_text }}\n\n1. In \"summary\": Write a 1-sentence summary of what this company sells or offers.\n2. In \"cold_email\": Write a short, natural cold email in English (under 70 words) addressed to the company founder. Start with a specific compliment/observation based on their actual services from the website, and offer to build them a custom AI automation workflow (using n8n) that saves 5+ hours/week on lead follow-ups and customer support. Do not use placeholders like [Your Name], sign off simply as \"Adem\".",
